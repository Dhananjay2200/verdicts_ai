# ==========================================
# Verdicts AI - Environment Configuration Template
# ==========================================

APP_NAME=Verdicts AI
APP_ENV=production
DEBUG=False
PORT=8088
HOST=127.0.0.1
SITE_URL=https://verdicts.in
FRONTEND_URL=https://verdicts.in
ALLOWED_HOSTS=verdicts.in,www.verdicts.in,127.0.0.1,localhost
CORS_ORIGINS=https://verdicts.in,https://www.verdicts.in

NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL_NAME=nvidia/nemotron-3.5-bolt-e4b
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=60

TAVILY_API_KEY=your_tavily_api_key_here
TAVILY_SEARCH_DEPTH=advanced

UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=

DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/verdicts_ai
DB_POOL_SIZE=15
DB_MAX_OVERFLOW=30
DB_ECHO=False

DAILY_ARTICLE_LIMIT=200
DEFAULT_QUALITY_THRESHOLD=8.0

ADMIN_USERNAME=admin
ADMIN_PASSWORD=verdictsadmin123
JWT_SECRET_KEY=verdicts-ai-super-secret-judicial-jwt-key-2026
COOKIE_DOMAIN=.verdicts.in
COOKIE_SAMESITE=lax
COOKIE_SECURE=True
